{
  "name": "resk-llm-ts",
  "version": "1.0.0",
  "description": "Comprehensive security toolkit for LLM applications - TypeScript - https://resk.fr",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && mkdir -p dist/v2/config && cp src/v2/config/patterns.json dist/v2/config/",
    "build:prod": "bun run build",
    "test": "bun run src/v2/index.test.ts",
    "lint": "tsc --noEmit",
    "docs:build": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resk-Security/resk-llm-ts.git"
  },
  "keywords": [
    "llm",
    "ai",
    "security",
    "openrouter",
    "resk",
    "prompt-injection",
    "bun",
    "typescript"
  ],
  "author": "Resk <contact@resk.fr>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Resk-Security/resk-llm-ts/issues"
  },
  "homepage": "https://github.com/Resk-Security/resk-llm-ts#readme",
  "dependencies": {},
  "peerDependencies": {
    "express": "^4.22.1",
    "hono": "^4.x",
    "openai": "^4.96.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "flatted": "^3.4.4",
    "hono": "^4.13.7",
    "minimatch": "^10.2.6",
    "picomatch": "^4.0.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*"
  ],
  "overrides": {
    "body-parser": "^1.20.6",
    "form-data": "^4.0.6",
    "qs": "^6.15.4"
  }
}
